# Copy this file to .env and fill values
# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finwise?retryWrites=true&w=majority

# Optional: port override
PORT=5000

# Optional: API keys
GEMINI_API_KEY=

# Client URL for CORS (optional)
# CLIENT_URL=http://localhost:5173
