# Example server env for MongoDB Atlas
# Copy this to `server/.env` and fill values before running the server

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yourDB?retryWrites=true&w=majority
PORT=5000
FRONTEND_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_MONTHLY_PLAN_ID=plan_your_monthly_plan_id
RAZORPAY_YEARLY_PLAN_ID=plan_your_yearly_plan_id
